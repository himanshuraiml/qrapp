# --- npm install memory safety ---
# IMPORTANT: npm's OWN resolver heap is NOT limited by an `.npmrc` `node-options`
# line — that only affects lifecycle scripts, not npm/arborist itself. To cap npm
# itself you must set the NODE_OPTIONS env var when running it, e.g.:
#   NODE_OPTIONS=--max-old-space-size=4096 npm ci
# The real fix is the committed package-lock.json: it makes installs deterministic
# (`npm ci`) and avoids the unbounded peer-dependency graph resolution that was
# exhausting RAM + swap. Always prefer `npm ci` over `npm install` here.

# Keep network/extraction parallelism low to reduce peak memory.
network-concurrency=3
jobs=2
maxsockets=3

# Skip the audit + fund passes (extra graph work / network on every install).
audit=false
fund=false

# Reuse the local cache instead of refetching when possible.
prefer-offline=true

# Resilient fetches on flaky networks.
fetch-retries=3
fetch-retry-mintimeout=5000
